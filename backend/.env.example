PORT=3000

# PayPal sandbox is the default. Use PayPal's live API URL only for a deliberate
# production deployment with live credentials.
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_BASE_URL=https://api-m.sandbox.paypal.com
PAYPAL_RETURN_URL=http://localhost:3000/paypal/return
PAYPAL_CANCEL_URL=http://localhost:3000/paypal/cancel

# Example: postgresql://USER:PASSWORD@HOST:5432/DATABASE?sslmode=require
DATABASE_URL=

# Assessment agent (needed only when using the Gemini provider)
GEMINI_API_KEY=
TRUSTFLOW_MODEL=
TRUSTFLOW_FALLBACK_MODEL=

# Optional Elastic APM request/error monitoring. Leave URL empty to disable.
ELASTIC_APM_SERVER_URL=
ELASTIC_APM_SECRET_TOKEN=
ELASTIC_APM_SERVICE_NAME=trustflow-backend
ELASTIC_APM_ENVIRONMENT=development

# Optional Zapier Catch Hook URL for assessment and payment lifecycle events.
ZAPIER_WEBHOOK_URL=
