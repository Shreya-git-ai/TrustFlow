PORT=3000
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
TRUSTFLOW_ENV=development
# Set a unique random value for deployed environments. Do not reuse this example.
SESSION_HASH_SALT=replace-with-a-long-random-value
TRUSTFLOW_FRONTEND_URL=http://localhost:5173

# Optional SMTP email delivery. Configuring this enables signup confirmation
# and project invitation emails. Use a provider app password/API SMTP credential.
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=
SMTP_USE_SSL=false
SMTP_USE_STARTTLS=true

# PayPal sandbox is the default. Use PayPal's live API URL only for a deliberate
# production deployment with live credentials.
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_BASE_URL=https://api-m.sandbox.paypal.com
PAYPAL_RETURN_URL=http://localhost:5173/payment-return
PAYPAL_CANCEL_URL=http://localhost:5173/payment-cancel
PAYPAL_WEBHOOK_ID=

# Example: postgresql://USER:PASSWORD@HOST:5432/DATABASE?sslmode=require
DATABASE_URL=

# Assessment agent (needed only when using the Gemini provider)
GEMINI_API_KEY=
TRUSTFLOW_MODEL=
TRUSTFLOW_FALLBACK_MODEL=

# Optional Elastic APM request/error monitoring. Leave URL empty to disable.
ELASTIC_APM_SERVER_URL=
ELASTIC_APM_SECRET_TOKEN=
ELASTIC_APM_SERVICE_NAME=trustflow-backend
ELASTIC_APM_ENVIRONMENT=development

# Optional backend-only Zapier Catch Hook URL for workflow, payment, and refund events.
# Target email addresses are included in notifications so Zaps can email test/project users.
ZAPIER_WEBHOOK_URL=

# Required bearer token for the trusted agent refund-proposal intake endpoint.
TRUSTFLOW_AGENT_TOKEN=
