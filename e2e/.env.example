# Frontend origin, for example http://localhost:5173
BASE_URL=

# Dedicated, pre-created TrustFlow accounts. Do not use production credentials.
CLIENT_EMAIL=
CLIENT_PASSWORD=
FREELANCER_EMAIL=
FREELANCER_PASSWORD=

# Optional third client account for cross-client project privacy testing.
OTHER_CLIENT_EMAIL=
OTHER_CLIENT_PASSWORD=

# PostgreSQL connection used only by the E2E database scripts.
DATABASE_URL=

# Required exact allowlists for seed/cleanup/verification scripts.
# Host is the hostname only (no port); database is current_database().
E2E_DATABASE_HOST_ALLOWLIST=
E2E_DATABASE_NAME_ALLOWLIST=
E2E_DATABASE_USER_ALLOWLIST=
E2E_ALLOW_SEED=false

# Additional deliberate override for production-looking host/database names.
E2E_ALLOW_PRODUCTION_DATABASE=false

# Optional PayPal Sandbox buyer. Only needed by the Sandbox checkout test.
PAYPAL_SANDBOX_BUYER_EMAIL=
PAYPAL_SANDBOX_BUYER_PASSWORD=
